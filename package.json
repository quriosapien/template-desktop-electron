{
  "name": "template-desktop-electron",
  "productName": "Template Desktop Electron",
  "version": "0.1.0",
  "description": "Production-grade Electron + Vue 3 + TypeScript desktop template (Vite, tsdown, electron-builder, keychain-backed JWT auth, auto-update).",
  "type": "module",
  "private": true,
  "main": "dist-electron/main/index.js",
  "homepage": "https://github.com/quriosapien/template-desktop-electron",
  "author": {
    "name": "quriosapien",
    "email": "quriosapien@users.noreply.github.com"
  },
  "engines": {
    "node": ">=26"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=12",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "npm run typecheck && vite build && tsdown",
    "start": "electron .",
    "dist": "npm run build && electron-builder --config electron-builder.config.ts",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p electron",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:ci": "biome ci .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "electron": "^44.10.1",
    "electron-builder": "^26.18.1",
    "jsdom": "^30.1.3",
    "lefthook": "^2.2.2",
    "msw": "^3.0.3",
    "pinia": "^4.1.0",
    "sharp": "^0.35.5",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.14",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "electron-winstaller": false,
    "fsevents@2.3.3": true,
    "lefthook@2.2.2": true
  }
}
