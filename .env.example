# ── UI (exposed to the renderer bundle — never put secrets in VITE_* vars) ──
VITE_APP_NAME=template-desktop-electron
# Relative works in dev (the Vite server answers it). Packaged builds need an
# absolute URL — set it in .env.production. Its origin is added to the CSP's
# connect-src automatically (tsdown inlines it into main; see security.ts).
VITE_API_BASE_URL=/api

# ── Dev server only (read by vite.config.ts in Node; never reaches the UI) ──
# Serve the MSW handlers in src/mocks/ from the Vite dev server.
DEV_MOCK_API=true
# Flip DEV_PROXY=true and DEV_MOCK_API=false to hit a real backend instead.
DEV_PROXY=false
DEV_PROXY_TARGET=http://localhost:3000
